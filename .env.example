# Google-only local runtime; existing port 3000 remains untouched.
STUDIO_LOCAL_PORT=3001
STUDIO_NODE_ENV=production
STUDIO_AUTH_MODE=google
AI_ALLOW_SYNTHETIC=true
# Firebase web application values are public configuration, not service-account keys.
STUDIO_FIREBASE_PROJECT_ID=
STUDIO_FIREBASE_API_KEY=
STUDIO_FIREBASE_AUTH_DOMAIN=
STUDIO_FIREBASE_APP_ID=
STUDIO_GOOGLE_FOUNDER_EMAIL=
STUDIO_GOOGLE_MARKETER_EMAIL=
# Optional local ADC mount: explicitly use compose.google-adc.yaml (see docs).
# STUDIO_LOCAL_ADC_PATH=/absolute/path/to/application_default_credentials.json

# Optional authenticated inspection specification only; no native editor integration.
STUDIO_EDITOR_CONTRACT_ENABLED=false
