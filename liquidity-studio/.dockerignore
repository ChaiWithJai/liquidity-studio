# Allowlist: exclude credentials, local state, dependencies, and repository metadata.
**
!Dockerfile
!package.json
!package-lock.json
!index.html
!vite.config.js
!src/
!src/**
!scripts/
!scripts/build-dist.js
!scripts/native-editor-vite.js
!server/
!server/*.js
server/*test*.js
server/fixtures/

!public/
!public/**

# The optional local Penpot plugin contains only our static bridge, never operator config.
!tools/
!tools/penpot-token-plugin/
!tools/penpot-token-plugin/index.html
!tools/penpot-token-plugin/action.js
!tools/penpot-token-plugin/plugin-tail.js
!tools/penpot-token-plugin/style.css
!tools/penpot-token-plugin/ui.js

# Full pinned attribution texts are canonical build inputs.
!licenses/
!licenses/defiant-vendored/
!licenses/defiant-vendored/**
