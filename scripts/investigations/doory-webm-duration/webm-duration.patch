+import { expect, it } from 'vitest'
+import { Muxer, ArrayBufferTarget } from 'webm-muxer'
+import { correctMuxedWebmDuration } from './muxedWebmDuration'
+import { createContainer } from './container'
+import { bytesOf } from './testing'
+const join = (...p: Uint8Array[]) => Uint8Array.from(p.flatMap(x => [...x]))
+const el = (id: number[], b: Uint8Array) => join(Uint8Array.from([...id, 0x80 | b.length]), b)
+const double = (n: number) => { const b = new Uint8Array(8); new DataView(b.buffer).setFloat64(0, n); return b }
+const duration = (n = 66) => el([0x44, 0x89], double(n))
+const file = (fields: Uint8Array, extras = new Uint8Array()) => join(el([0x1a, 0x45, 0xdf, 0xa3], new Uint8Array()), el([0x18, 0x53, 0x80, 0x67], join(el([0x15, 0x49, 0xa9, 0x66], fields), extras))).buffer
+const offset = (b: ArrayBuffer) => new Uint8Array(b).findIndex((_, i, a) => a[i] === 0x44 && a[i + 1] === 0x89 && a[i + 2] === 0x88) + 3
+const value = (b: ArrayBuffer) => new DataView(b).getFloat64(offset(b))
+it('reproduces actual muxer metadata and changes only eight Duration bytes', () => {
+ const target = new ArrayBufferTarget(), mux = new Muxer({target, video:{codec:'V_VP8',width:16,height:16,frameRate:30}})
+ for(let i=0;i<900;i++) mux.addVideoChunkRaw(new Uint8Array([0,0,0]),'key',Math.round(i*1e6/30))
+ mux.finalize()
+ const original=target.buffer.slice(0), fixed=correctMuxedWebmDuration(target.buffer,30_000_000)
+ expect(value(original)).toBe(29966);expect(value(fixed)).toBe(30000);expect(fixed.byteLength).toBe(original.byteLength)
+ const b=new Uint8Array(original),n=new Uint8Array(fixed),at=offset(original)
+ expect([...b.keys()].filter(i=>b[i]!==n[i]).every(i=>i>=at&&i<at+8)).toBe(true)
+ expect(new Uint8Array(target.buffer)).toEqual(b)
+})
+it('honors timestamp scale and rejects shrinking or invalid end time',()=>{
+ const b=file(join(el([0x2a,0xd7,0xb1],new Uint8Array([0x1e,0x84,0x80])),duration(20)))
+ expect(value(correctMuxedWebmDuration(b,100_000))).toBe(50)
+ for(const n of [0,-1,NaN,Infinity,1.5,Number.MAX_SAFE_INTEGER+1,10_000]) expect(()=>correctMuxedWebmDuration(b,n)).toThrow()
+})
+it('rejects empty/missing/duplicate/truncated/non-Float64 metadata',()=>{
+ for(const b of [new ArrayBuffer(0),join(el([0x1a,0x45,0xdf,0xa3],new Uint8Array()),el([0x18,0x53,0x80,0x67],new Uint8Array())).buffer,file(new Uint8Array()),file(join(duration(),duration())),file(duration()).slice(0,-1),file(el([0x44,0x89],new Uint8Array(4))),file(join(el([0x2a,0xd7,0xb1],new Uint8Array([0])),duration())),file(duration(NaN)),file(duration(),el([0x15,0x49,0xa9,0x66],duration()))]) expect(()=>correctMuxedWebmDuration(b,100_000)).toThrow()
+})
+it('container takes maximum actual video/audio end rather than fps or arrival order',async()=>{
+ const c=await createContainer({kind:'webm',family:'vp8',width:16,height:16,fps:30,audio:{codec:'opus',sampleRate:48000,numberOfChannels:1}})
+ c.addVideo({data:new Uint8Array([0,0,0]),key:true,timestampUs:0,durationUs:80_000})
+ c.addAudio({data:new Uint8Array([0,0]),timestampUs:0,durationUs:120_000})
+ c.addVideo({data:new Uint8Array([0,0,0]),key:true,timestampUs:80_000,durationUs:10_000})
+ expect(value((await bytesOf(c.finish())).buffer as ArrayBuffer)).toBe(120)
+ const e=await createContainer({kind:'webm',family:'vp8',width:16,height:16,fps:30,audio:null})
+ expect(()=>e.finish()).toThrow();expect(()=>e.addVideo({data:new Uint8Array([0]),key:true,timestampUs:0,durationUs:0})).toThrow()
+})
diff --git a/frontend/src/editor/engine/export/video/muxedWebmDuration.ts b/frontend/src/editor/engine/export/video/muxedWebmDuration.ts
