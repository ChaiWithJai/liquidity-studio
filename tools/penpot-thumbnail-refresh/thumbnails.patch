-;; Board thumbnails used to render text shapes without position-data as
-;; nothing instead of falling back to the foreignObject renderer (see
-;; frame-imposter in app.main.render), so any board thumbnail cached before
-;; that fix may be missing its text. The backend doesn't tell the client
-;; when a fetched thumbnail was generated, so we can't tell stale apart from
-;; fresh by inspecting it; instead each board thumbnail with text content is
-;; regenerated at most once per browser, tracked via local-storage so repeat
-;; visits (once healed) don't keep re-rendering it.
-(def ^:private healed-storage-key ::healed-text-thumbnails)
-
+(defn- clear-local-thumbnail
+  "Hide only this browser's stale bitmap. Retain its URI so the frame's initial
+  mount fallback cannot mistake invalidation for a missing server thumbnail."
+  [object-id]
+  (ptk/reify ::clear-local-thumbnail
+    cljs.core/IDeref
+    (-deref [_] object-id)
+    ptk/UpdateEvent
+    (update [_ state]
+      (assoc-in state [:thumbnails object-id :stale?] true))))
+
+(defn- refresh-local-thumbnail
+  "Render through the existing bounded queue, without persisting a server thumbnail."
+  [file-id page-id frame-id]
+  (let [object-id (thc/fmt-object-id file-id page-id frame-id "frame")]
+    (ptk/reify ::refresh-local-thumbnail
+      cljs.core/IDeref
+      (-deref [_] object-id)
+      ptk/WatchEvent
+      (watch [_ state stream]
+        (->> (request-thumbnail state file-id page-id frame-id "frame")
+             (rx/map #(assoc-thumbnail object-id (wapi/create-uri %)))
+             (rx/catch (fn [_] (rx/empty)))
+             (rx/take-until
+              (->> stream
+                   (rx/filter #(or (ptk/type? ::dwpg/finalize-page %)
+                                   (and (ptk/type? ::clear-thumbnail %) (= (deref %) object-id)))))))))))
+
+;; A permanent browser-local healed marker cannot prove a stored bitmap is current.
